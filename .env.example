4155548393fd474f
CLIENT_URL=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
JOBS_ENABLED=true
# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SMS (Termii). Without a key, codes are only logged in development.
TERMII_API_KEY=
TERMII_SENDER_ID=Along
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com

# File uploads (any S3-compatible storage: Cloudflare R2, AWS S3, Backblaze B2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL for profile photos (e.g. an R2 public domain)
S3_PUBLIC_BASE_URL=

# WhatsApp (optional). Lets riders book by chat and get updates there. Set to false to switch it all off.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Your WhatsApp number in digits with country code, for chat links (e.g. 2348012345678)
WHATSAPP_BUSINESS_NUMBER=
# Names of message templates you created and Meta approved (see README)
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Send login codes by sms or whatsapp (whatsapp falls back to sms if it fails)
OTP_CHANNEL=sms
# Link to your terms page, shown to new riders who sign up on WhatsApp
TERMS_URL=

# Driver demand alerts: tell drivers how many riders are looking for a cab at stops ahead.
# Set to false to switch the whole feature off.
DEMAND_ALERTS_ENABLED=true
# How many riders must be looking at a stop before the driver is notified
DEMAND_ALERT_MIN_RIDERS=2

# Wallet and payments (Paystack). Without a secret key, top-ups use a test button in development only.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Along's cut of wallet-paid rides (percent). Staff carpool fuel shares default to no cut.
COMMISSION_PERCENT=10
COMMUTE_COMMISSION_PERCENT=0
# Share of the fare charged when a wallet-paying rider does not show up (percent)
NO_SHOW_FEE_PERCENT=0
# manual = an admin approves each withdrawal; auto = pay out immediately
WITHDRAWAL_MODE=manual
MIN_WITHDRAWAL_KOBO=100000
WITHDRAWAL_FEE_KOBO=0
